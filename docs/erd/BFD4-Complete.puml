@startuml BFD4
skinparam linetype ortho
hide circle

entity "assessment_types" as assessment_types {
  id : INT UNSIGNED <<PK>>
  name_ar : VARCHAR(100)
  name_en : VARCHAR(100)
  code : VARCHAR(20) <<UNIQUE>>
  weight_default : DECIMAL(5,2)
  sort_order : INT UNSIGNED
  is_active : TINYINT(1)
}

entity "assessment_forms" as assessment_forms {
  id : INT UNSIGNED <<PK>>
  form_key : ENUM(behavior_eval,skills_checklist,teaching_self,teaching_peer,teaching_admin,climate_survey,facility_checklist,teacher_satisfaction,parent_satisfaction)
  name_ar : VARCHAR(200)
  name_en : VARCHAR(200)
  category : ENUM(behavior,skills,teaching,climate)
  target : ENUM(student,teacher,school)
  description : TEXT
  is_system : TINYINT(1)
  is_default : TINYINT(1)
  version : VARCHAR(50)
  is_active : TINYINT(1)
  created_at : DATETIME
}

entity "assessment_structure" as assessment_structure {
  id : INT UNSIGNED <<PK>>
  form_id : INT UNSIGNED <<FK>> [to assessment_forms.id] [BFD4]
  parent_id : INT UNSIGNED <<FK>> [self-ref]
  type : ENUM(criteria,item)
  name_ar : VARCHAR(200)
  name_en : VARCHAR(200)
  text_ar : TEXT
  text_en : TEXT
  tool_type : ENUM(likert_5,frequency_5,satisfaction_5,yes_no,severity_4,counter,numeric_100,numeric_custom,rubric_4,text)
  weight : DECIMAL(5,2)
  is_inverse : TINYINT(1)
  max_value : DECIMAL(10,2)
  sort_order : INT UNSIGNED
  is_active : TINYINT(1)
}

entity "assessment_responses" as assessment_responses {
  id : INT UNSIGNED <<PK>>
  evaluation_id : INT UNSIGNED <<FK>> [to evaluations.id] [BFD4]
  form_id : INT UNSIGNED <<FK>> [to assessment_forms.id] [BFD4]
  item_id : INT UNSIGNED <<FK>> [to assessment_structure.id] [BFD4]
  student_id : INT UNSIGNED <<FK>> [to students.id] [BFD2]
  teacher_id : INT UNSIGNED <<FK>> [to users.id] [BFD1]
  school_id : INT UNSIGNED <<FK>> [to schools.id] [BFD2]
  class_id : INT UNSIGNED <<FK>> [to classes.id] [BFD2]
  academic_year_id : INT UNSIGNED <<FK>> [to academic_years.id] [BFD2]
  semester_id : INT UNSIGNED <<FK>> [to semesters.id] [BFD2]
  numeric_value : DECIMAL(10,4)
  text_value : TEXT
  responded_by : INT UNSIGNED <<FK>> [to users.id] [BFD1]
  response_date : DATETIME
  is_active : TINYINT(1)
}

entity "tests" as tests {
  id : INT UNSIGNED <<PK>>
  subject_id : INT UNSIGNED <<FK>> [to subjects.id] [BFD2]
  class_id : INT UNSIGNED <<FK>> [to classes.id] [BFD2]
  assessment_type_id : INT UNSIGNED <<FK>> [to assessment_types.id] [BFD4]
  academic_year_id : INT UNSIGNED <<FK>> [to academic_years.id] [BFD2]
  semester_id : INT UNSIGNED <<FK>> [to semesters.id] [BFD2]
  title_ar : VARCHAR(200)
  max_grade : DECIMAL(5,2)
  test_date : DATE
  status : ENUM(draft,published,locked)
  created_by : INT UNSIGNED <<FK>> [to users.id] [BFD1]
  is_active : TINYINT(1)
  created_at : DATETIME
}

entity "grades" as grades {
  id : INT UNSIGNED <<PK>>
  student_id : INT UNSIGNED <<FK>> [to students.id] [BFD2]
  test_id : INT UNSIGNED <<FK>> [to tests.id] [BFD4]
  academic_year_id : INT UNSIGNED
  semester_id : INT UNSIGNED
  grade_value : DECIMAL(7,2)
  max_value : DECIMAL(7,2)
  percentage : DECIMAL(7,2)
  letter_grade : VARCHAR(3)
  notes : TEXT
  graded_by : INT UNSIGNED <<FK>> [to users.id] [BFD1]
  is_active : TINYINT(1)
  created_at : DATETIME
  updated_at : DATETIME
}

entity "learning_outcomes" as learning_outcomes {
  id : INT UNSIGNED <<PK>>
  subject_id : INT UNSIGNED <<FK>> [to subjects.id] [BFD2]
  code : VARCHAR(20)
  description_ar : TEXT
  description_en : TEXT
  is_active : TINYINT(1)
}

entity "evaluations" as evaluations {
  id : INT UNSIGNED <<PK>>
  eval_type : ENUM(teaching_summary,behavior_score,skills_checklist)
  teacher_id : INT UNSIGNED <<FK>> [to users.id] [BFD1]
  student_id : INT UNSIGNED <<FK>> [to students.id] [BFD2]
  class_id : INT UNSIGNED <<FK>> [to classes.id] [BFD2]
  school_id : INT UNSIGNED <<FK>> [to schools.id] [BFD2]
  academic_year_id : INT UNSIGNED <<FK>> [to academic_years.id] [BFD2]
  semester_id : INT UNSIGNED <<FK>> [to semesters.id] [BFD2]
  evaluated_by : INT UNSIGNED
  self_score : DECIMAL(5,2)
  peer_score : DECIMAL(5,2)
  admin_score : DECIMAL(5,2)
  combined_score : DECIMAL(5,2)
  adjusted_score : DECIMAL(5,2)
  starting_points : DECIMAL(5,2)
  earned_points : DECIMAL(5,2)
  deducted_points : DECIMAL(5,2)
  current_percentage : DECIMAL(5,2)
  notes : TEXT
  is_passing : TINYINT(1)
  is_active : TINYINT(1)
  created_at : DATETIME
  updated_at : DATETIME
}

entity "surveys" as surveys {
  id : INT UNSIGNED <<PK>>
  survey_type : ENUM(climate,facility)
  school_id : INT UNSIGNED <<FK>> [to schools.id] [BFD2]
  academic_year_id : INT UNSIGNED <<FK>> [to academic_years.id] [BFD2]
  semester_id : INT UNSIGNED <<FK>> [to semesters.id] [BFD2]
  respondent_type : ENUM(teacher,student,parent,admin,evaluator)
  respondent_id : INT UNSIGNED <<FK>> [to users.id] [BFD1]
  evaluator_id : INT UNSIGNED
  survey_date : DATE
  overall_score : DECIMAL(5,2)
  notes : TEXT
  status : ENUM(draft,active,closed)
  is_active : TINYINT(1)
  created_by : INT UNSIGNED <<FK>> [to users.id] [BFD1]
  created_at : DATETIME
  updated_at : DATETIME
}

entity "survey_items" as survey_items {
  id : INT UNSIGNED <<PK>>
  survey_id : INT UNSIGNED <<FK>> [to surveys.id] [BFD4]
  item_id : INT UNSIGNED <<FK>> [to assessment_structure.id] [BFD4]
  numeric_value : DECIMAL(10,4)
  normalized_value : DECIMAL(5,2)
  is_active : TINYINT(1)
}

entity "climate_items" as climate_items {
  id : INT UNSIGNED <<PK>>
  survey_id : INT UNSIGNED <<FK>> [to surveys.id] [BFD4]
  item_id : INT UNSIGNED <<FK>> [to assessment_structure.id] [BFD4]
  numeric_value : DECIMAL(10,4)
  normalized_value : DECIMAL(5,2)
  is_active : TINYINT(1)
}

entity "facility_items" as facility_items {
  id : INT UNSIGNED <<PK>>
  checklist_id : INT UNSIGNED <<FK>> [to surveys.id] [BFD4]
  item_id : INT UNSIGNED <<FK>> [to assessment_structure.id] [BFD4]
  numeric_value : DECIMAL(10,4)
  normalized_value : DECIMAL(5,2)
  notes : TEXT
  is_active : TINYINT(1)
}

entity "eqi_results" as eqi_results {
  id : INT UNSIGNED <<PK>>
  school_id : INT UNSIGNED <<FK>> [to schools.id] [BFD2]
  academic_year_id : INT UNSIGNED <<FK>> [to academic_years.id] [BFD2]
  semester_id : INT UNSIGNED <<FK>> [to semesters.id] [BFD2]
  academic_score : DECIMAL(5,2)
  teaching_score : DECIMAL(5,2)
  climate_score : DECIMAL(5,2)
  behavior_score : DECIMAL(5,2)
  skills_score : DECIMAL(5,2)
  attendance_score : DECIMAL(5,2)
  overall_eqi : DECIMAL(5,2)
  weights_json : LONGTEXT
  context_json : LONGTEXT
  challenge_index : DECIMAL(5,2)
  adjusted_eqi : DECIMAL(5,2)
  missing_dimensions : LONGTEXT
  calculated_by : INT UNSIGNED <<FK>> [to users.id] [BFD1]
  is_active : TINYINT(1)
  created_at : DATETIME
}

entity "improvement_plans" as improvement_plans {
  id : INT UNSIGNED <<PK>>
  plan_type : ENUM(student,school,teacher)
  student_id : INT UNSIGNED <<FK>> [to students.id] [BFD2]
  school_id : INT UNSIGNED <<FK>> [to schools.id] [BFD2]
  teacher_id : INT UNSIGNED <<FK>> [to users.id] [BFD1]
  trigger_type : ENUM(climate,facility,both,low_score,behavior)
  weaknesses : TEXT
  goals : TEXT
  strategies : TEXT
  timeline : VARCHAR(200)
  responsible_user_id : INT UNSIGNED <<FK>> [to users.id] [BFD1]
  parent_involvement : TEXT
  status : ENUM(active,completed,cancelled)
  progress : INT
  follow_up_date : DATE
  notes : TEXT
  created_by : INT UNSIGNED <<FK>> [to users.id] [BFD1]
  updated_by : INT UNSIGNED <<FK>> [to users.id] [BFD1]
  is_active : TINYINT(1)
  created_at : DATETIME
  updated_at : DATETIME
}

entity "school_improvement_plans" as school_improvement_plans {
  id : INT UNSIGNED <<PK>>
  school_id : INT UNSIGNED <<FK>> [to schools.id] [BFD2]
  academic_year_id : INT UNSIGNED <<FK>> [to academic_years.id] [BFD2]
  semester_id : INT UNSIGNED <<FK>> [to semesters.id] [BFD2]
  trigger_type : ENUM(climate,facility,both)
  weaknesses : TEXT
  goals : TEXT
  strategies : TEXT
  timeline : VARCHAR(200)
  responsible_user_id : INT UNSIGNED <<FK>> [to users.id] [BFD1]
  status : ENUM(active,completed,cancelled)
  progress : INT
  notes : TEXT
  created_by : INT UNSIGNED <<FK>> [to users.id] [BFD1]
  updated_by : INT UNSIGNED <<FK>> [to users.id] [BFD1]
  is_active : TINYINT(1)
  created_at : DATETIME
  updated_at : DATETIME
}

entity "promotions" as promotions {
  id : INT UNSIGNED <<PK>>
  student_id : INT UNSIGNED <<FK>> [to students.id] [BFD2]
  academic_year_id : INT UNSIGNED <<FK>> [to academic_years.id] [BFD2]
  semester_id : INT UNSIGNED <<FK>> [to semesters.id] [BFD2]
  academic_score : DECIMAL(5,2)
  behavior_score : DECIMAL(5,2)
  attendance_score : DECIMAL(5,2)
  academic_pass : TINYINT(1)
  behavior_pass : TINYINT(1)
  attendance_pass : TINYINT(1)
  decision : ENUM(promoted,repeated,conditional,under_review)
  status : ENUM(proposed,approved,rejected)
  override_json : LONGTEXT
  approved_by : INT UNSIGNED <<FK>> [to users.id] [BFD1]
  approved_at : DATETIME
  rejection_reason : TEXT
  notes : TEXT
  decided_by : INT UNSIGNED <<FK>> [to users.id] [BFD1]
  is_active : TINYINT(1)
  created_at : DATETIME
}

entity "promotion_overrides" as promotion_overrides {
  id : INT UNSIGNED <<PK>>
  student_id : INT UNSIGNED <<FK>> [to students.id] [BFD2]
  academic_year_id : INT UNSIGNED <<FK>> [to academic_years.id] [BFD2]
  semester_id : INT UNSIGNED <<FK>> [to semesters.id] [BFD2]
  criterion : ENUM(academic,behavior,attendance)
  override_reason : TEXT
  approved_by : INT UNSIGNED <<FK>> [to users.id] [BFD1]
  approved_at : DATETIME
  is_active : TINYINT(1)
}

@enduml