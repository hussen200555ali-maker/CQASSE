@startuml 02-Users-Permissions
skinparam linetype ortho
skinparam rectangle {+ backgroundColor White }

entity "users" as users {
  id : int(10)
  username : varchar(50)
  password_hash : varchar(255)
  must_change_password : tinyint(1)
  full_name_ar : varchar(200)
  full_name_en : varchar(200)
  email : varchar(100)
  phone : varchar(20)
  * role_id : int(10)
  * school_id : int(10)
}

entity "permissions" as permissions {
  id : int(10)
  name : varchar(100)
  name_ar : varchar(200)
  module : varchar(50)
  description : text
  is_active : tinyint(1)
}

entity "role_permissions" as role_permissions {
  id : int(10)
  * role_id : int(10)
  * permission_id : int(10)
  is_active : tinyint(1)
}

