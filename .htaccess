# ============================================================================
# نظام التقييم الشامل لجودة التعليم المدرسي  - EQAS
# ملف حماية المجلد الجذري
# ============================================================================

RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# حماية المجلدات الحساسة
RewriteRule ^backups/ - [F,L]
RewriteRule ^temp/ - [F,L]
RewriteRule ^database/ - [F,L]
RewriteRule ^includes/ - [F,L]

# ============================================================================
# رؤوس الأمان HTTP Security Headers [SEC-001] - v2.0.2
# ============================================================================
<IfModule mod_headers.c>
    # منع Clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"

    # منع MIME Sniffing
    Header always set X-Content-Type-Options "nosniff"

    # حماية XSS
    Header always set X-XSS-Protection "1; mode=block"

    # سياسة الإحالة
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # سياسة الصلاحيات
    Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"

    # سياسة أمان المحتوى CSP — تُدار من includes/security_headers.php (ديناميكية مع nonce)
    # ملاحظة: لا يُحدد هنا لتجنب تعارض مع السياسة الديناميكية من PHP

    # HSTS - إجبار HTTPS (للمحلات التي تستخدم HTTPS)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # منع التخزين المؤقت للصفحات الديناميكية
    Header always set Cache-Control "no-store, no-cache, must-revalidate"
    Header always set Pragma "no-cache"
</IfModule>

# تعطيل عرض محتويات المجلدات
Options -Indexes

# إعدادات PHP
php_value upload_max_filesize 50M
php_value post_max_size 50M
php_value max_execution_time 300
php_value max_input_time 300
php_value memory_limit 256M

# منع الوصول للملفات الحساسة
<FilesMatch "\.(sql|log|env|bak|old|orig|tmp)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# منع الوصول لملفات التكوين
<FilesMatch "(config|database|settings)\.php$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# ضغط GZIP
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE application/xml application/xhtml+xml
</IfModule>

# التخزين المؤقت
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>
