# ============================================================================
# نظام التقييم الشامل لجودة التعليم المدرسي  - EQAS
# ملف حماية المجلد الجذري
# ============================================================================

RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# حماية المجلدات الحساسة
RewriteRule ^backups/ - [F,L]
RewriteRule ^temp/ - [F,L]
RewriteRule ^database/ - [F,L]
RewriteRule ^includes/ - [F,L]
RewriteRule ^logs/ - [F,L]

# ============================================================================
# رؤوس الأمان — تُدار من includes/security_headers.php (PHP ديناميكية مع nonce)
# ملاحظة: تم إزالة الرؤوس المكررة من هنا لتجنب الإرسال المزدوج.
# راجع includes/security_headers.php للرؤوس المُدارة عبر PHP.
# ============================================================================
<IfModule mod_headers.c>
    # HSTS - إجبار HTTPS (يُرسل عبر .htaccess للملفات الثابتة التي لا تمر عبر PHP)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# تعطيل عرض محتويات المجلدات
Options -Indexes

# إعدادات PHP
php_value upload_max_filesize 50M
php_value post_max_size 50M
php_value max_execution_time 300
php_value max_input_time 300
php_value memory_limit 256M

# منع الوصول للملفات الحساسة
<FilesMatch "\.(sql|log|env|bak|old|orig|tmp)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# منع الوصول لملفات التكوين (ملفات الإعدادات في المسارات الفرعية مسموح بها)
<FilesMatch "(config|database)\.php$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# ضغط GZIP
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE application/xml application/xhtml+xml
</IfModule>

# التخزين المؤقت
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>
